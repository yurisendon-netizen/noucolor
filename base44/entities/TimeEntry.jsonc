{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "clock_in": {
      "type": "string",
      "format": "date-time"
    },
    "clock_out": {
      "type": "string",
      "format": "date-time"
    },
    "clock_in_lat": {
      "type": "number"
    },
    "clock_in_lng": {
      "type": "number"
    },
    "clock_out_lat": {
      "type": "number"
    },
    "clock_out_lng": {
      "type": "number"
    },
    "clock_in_fallback": {
      "type": "boolean",
      "default": false,
      "description": "True si la ubicaci\u00f3n de entrada es de respaldo (taller), no GPS real"
    },
    "clock_out_fallback": {
      "type": "boolean",
      "default": false,
      "description": "True si la ubicaci\u00f3n de salida es de respaldo (taller), no GPS real"
    },
    "total_hours": {
      "type": "number"
    },
    "overtime_hours": {
      "type": "number",
      "default": 0,
      "description": "Horas extras despues de las 16:00"
    },
    "auto_closed": {
      "type": "boolean",
      "default": false,
      "description": "Cerrado automaticamente a las 16:00"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "abierto",
        "cerrado",
        "ausencia_injustificada"
      ],
      "default": "abierto"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "clock_in",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.employee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.employee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.employee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}