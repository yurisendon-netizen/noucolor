{
  "name": "TimeEntry",
  "properties": {
    "auto_closed": {
      "default": false,
      "description": "Cerrado automaticamente a las 16:00",
      "type": "boolean"
    },
    "clock_in": {
      "format": "date-time",
      "type": "string"
    },
    "clock_in_accuracy": {
      "description": "Margen de error del GPS en metros al fichar la entrada",
      "type": "number"
    },
    "clock_in_fallback": {
      "default": false,
      "description": "True si la ubicaci\u00f3n de entrada es de respaldo (taller), no GPS real",
      "type": "boolean"
    },
    "clock_in_lat": {
      "type": "number"
    },
    "clock_in_lng": {
      "type": "number"
    },
    "clock_out": {
      "format": "date-time",
      "type": "string"
    },
    "clock_out_accuracy": {
      "description": "Margen de error del GPS en metros al fichar la salida",
      "type": "number"
    },
    "clock_out_fallback": {
      "default": false,
      "description": "True si la ubicaci\u00f3n de salida es de respaldo (taller), no GPS real",
      "type": "boolean"
    },
    "clock_out_lat": {
      "type": "number"
    },
    "clock_out_lng": {
      "type": "number"
    },
    "corregido_por_solicitud": {
      "default": false,
      "description": "True si el fichaje fue modificado por una solicitud de correccion aprobada",
      "type": "boolean"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "fichado_desde_entrada": {
      "description": "Terminal desde el que se fich\u00f3 la entrada (vac\u00edo = m\u00f3vil personal)",
      "type": "string"
    },
    "fichado_desde_salida": {
      "description": "Terminal desde el que se fich\u00f3 la salida (vac\u00edo = m\u00f3vil personal)",
      "type": "string"
    },
    "opened_by": {
      "description": "ID del empleado admin/jefe que abrio el fichaje manualmente",
      "type": "string"
    },
    "opened_by_admin": {
      "default": false,
      "description": "True si el fichaje lo abrio un admin/jefe manualmente (no el propio operario)",
      "type": "boolean"
    },
    "origen": {
      "description": "Desde d\u00f3nde se fich\u00f3 la ENTRADA: terminal (terminal del taller) o personal (m\u00f3vil propio). Vac\u00edo = fichajes antiguos o abiertos por un admin",
      "enum": [
        "terminal",
        "personal"
      ],
      "type": "string"
    },
    "origen_salida": {
      "description": "Desde d\u00f3nde se fich\u00f3 la SALIDA: terminal o personal. Vac\u00edo = antiguo, cierre autom\u00e1tico o admin",
      "enum": [
        "terminal",
        "personal"
      ],
      "type": "string"
    },
    "overtime_hours": {
      "default": 0,
      "description": "Horas extras despues de las 16:00",
      "type": "number"
    },
    "solicitud_correccion_id": {
      "description": "ID de la SolicitudCorreccion que origino la correccion",
      "type": "string"
    },
    "status": {
      "default": "abierto",
      "enum": [
        "abierto",
        "cerrado",
        "ausencia_injustificada"
      ],
      "type": "string"
    },
    "total_hours": {
      "type": "number"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "clock_in",
    "date"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "data.employee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.employee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.employee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}