{
  "name": "WorkOrder",
  "type": "object",
  "properties": {
    "address": {
      "type": "string"
    },
    "assigned_name": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "encargado_firma": {
      "description": "URL de la firma digital de l'encarregat",
      "type": "string"
    },
    "encargado_obra": {
      "description": "Nom de l'encarregat d'obra",
      "type": "string"
    },
    "horas_trabajadas": {
      "description": "Hores treballades per cada treballador",
      "items": {
        "properties": {
          "employee_id": {
            "type": "string"
          },
          "employee_name": {
            "type": "string"
          },
          "horas": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "materials": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "obra_id": {
      "type": "string",
      "description": "ID de la Obra a la que pertenece este parte (para el balance)"
    },
    "priority": {
      "default": "media",
      "enum": [
        "baja",
        "media",
        "alta"
      ],
      "type": "string"
    },
    "status": {
      "default": "pendiente",
      "enum": [
        "pendiente",
        "en_progreso",
        "completado"
      ],
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "total_horas": {
      "default": 0,
      "description": "Total d'hores del parte",
      "type": "number"
    }
  },
  "required": [
    "title",
    "client_name",
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}