{
  "name": "Employee",
  "properties": {
    "avatar_url": {
      "type": "string"
    },
    "base_salary": {
      "default": 0,
      "type": "number"
    },
    "dni": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "employee_code": {
      "description": "Codi d'empleat",
      "type": "string"
    },
    "estado_laboral": {
      "default": "activo",
      "description": "Estat laboral de l'empleat (admin el canvia manualment)",
      "enum": [
        "activo",
        "baja",
        "vacaciones"
      ],
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "hire_date": {
      "format": "date",
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "net_salary": {
      "default": 0,
      "description": "Salario neto mensual (\u20ac)",
      "type": "number"
    },
    "nss": {
      "type": "string"
    },
    "pass": {
      "description": "Contrasenya",
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "pin_hash": {
      "description": "Hash del codi de seguretat (PIN de 4 d\u00edgits) \u2014 mai el codi en clar",
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "precioHora": {
      "default": 0,
      "description": "Preu per hora (\u20ac)",
      "type": "number"
    },
    "precioHoraExtra": {
      "default": 0,
      "description": "Preu per hora extra (\u20ac), ja net",
      "type": "number"
    },
    "role": {
      "default": "operario",
      "enum": [
        "operario",
        "administrador",
        "jefe"
      ],
      "type": "string"
    },
    "session_token": {
      "description": "Hash del token de sessi\u00f3 (mai el token en clar)",
      "type": "string"
    },
    "user": {
      "description": "Nom d'usuari per login",
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "email",
    "role"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}