{
  "name": "Payroll",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_dni": {
      "type": "string"
    },
    "employee_nss": {
      "type": "string"
    },
    "employee_iban": {
      "type": "string"
    },
    "employee_position": {
      "type": "string"
    },
    "employee_hire_date": {
      "type": "string"
    },
    "period_month": {
      "type": "number"
    },
    "period_year": {
      "type": "number"
    },
    "precio_hora": {
      "type": "number",
      "description": "Preu per hora del treballador (€)",
      "default": 0
    },
    "precio_hora_extra": {
      "type": "number",
      "description": "Preu per hora extra pactat, en net (€)",
      "default": 0
    },
    "total_hours": {
      "type": "number",
      "description": "Hores treballades totals del període",
      "default": 0
    },
    "base_salary": {
      "type": "number"
    },
    "base_net_salary": {
      "type": "number",
      "description": "Salari net mensual pactat (€)"
    },
    "overtime_hours": {
      "type": "number",
      "default": 0
    },
    "overtime_pay": {
      "type": "number",
      "default": 0
    },
    "bonus": {
      "type": "number",
      "default": 0
    },
    "gross_salary": {
      "type": "number"
    },
    "cass_employee": {
      "type": "number",
      "description": "Cotització CASS treballador (6.5%)"
    },
    "irpf": {
      "type": "number",
      "description": "Retenció IRPF"
    },
    "other_deductions": {
      "type": "number",
      "default": 0
    },
    "net_salary": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "borrador",
        "emitida",
        "pagada"
      ],
      "default": "borrador"
    },
    "worker_signature_name": {
      "type": "string",
      "description": "Nom del treballador que ha firmat la nòmina"
    },
    "worker_signature_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data de la firma digital del treballador"
    },
    "worker_signature_url": {
      "type": "string",
      "description": "URL de la imatge de la firma digital del treballador"
    },
    "overtime_net": {
      "type": "number",
      "default": 0,
      "description": "Import net de les hores extres (hores × preu net)"
    },
    "overtime_gross": {
      "type": "number",
      "default": 0,
      "description": "Import brut de les hores extres (net / 0,935), cotitza a la CASS"
    },
    "bonus_gross": {
      "type": "number",
      "default": 0,
      "description": "Bonificacions en brut"
    },
    "cass_base": {
      "type": "number",
      "default": 0,
      "description": "Base de cotització CASS (salari brut total)"
    },
    "cass_employer": {
      "type": "number",
      "default": 0,
      "description": "Cotització CASS part empresa (15,5%)"
    },
    "calc_version": {
      "type": "number",
      "default": 1,
      "description": "2 = extres en brut amb CASS (Llei 31/2018 art. 71 i 77)"
    },
    "compte_hores": {
      "type": "string",
      "description": "Compte d'hores del mes (JSON) lliurat amb el butlletí (art. 59.2)"
    },
    "reclamacion_texto": {
      "type": "string",
      "description": "Reclamació del treballador (art. 59.2, 7 dies)"
    },
    "reclamacion_fecha": {
      "type": "string",
      "format": "date-time"
    },
    "reclamacion_estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "resuelta"
      ]
    },
    "reclamacion_respuesta": {
      "type": "string"
    },
    "reclamacion_resuelta_por": {
      "type": "string"
    },
    "reclamacion_resuelta_fecha": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "period_month",
    "period_year",
    "base_salary"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.employee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.employee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}