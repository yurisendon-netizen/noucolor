{
  "name": "Payroll",
  "properties": {
    "base_net_salary": {
      "description": "Salari net mensual pactat (\u20ac)",
      "type": "number"
    },
    "base_salary": {
      "type": "number"
    },
    "bonus": {
      "default": 0,
      "type": "number"
    },
    "bonus_gross": {
      "default": 0,
      "description": "Bonificacions en brut",
      "type": "number"
    },
    "calc_version": {
      "default": 1,
      "description": "2 = extres en brut amb CASS (Llei 31/2018 art. 71 i 77)",
      "type": "number"
    },
    "cass_base": {
      "default": 0,
      "description": "Base de cotitzaci\u00f3 CASS (salari brut total)",
      "type": "number"
    },
    "cass_employee": {
      "description": "Cotitzaci\u00f3 CASS treballador (6.5%)",
      "type": "number"
    },
    "cass_employer": {
      "default": 0,
      "description": "Cotitzaci\u00f3 CASS part empresa (15,5%)",
      "type": "number"
    },
    "compte_hores": {
      "description": "Compte d'hores del mes (JSON) lliurat amb el butllet\u00ed (art. 59.2)",
      "type": "string"
    },
    "employee_dni": {
      "type": "string"
    },
    "employee_hire_date": {
      "type": "string"
    },
    "employee_iban": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_nss": {
      "type": "string"
    },
    "employee_position": {
      "type": "string"
    },
    "gross_salary": {
      "type": "number"
    },
    "irpf": {
      "description": "Retenci\u00f3 IRPF",
      "type": "number"
    },
    "net_salary": {
      "type": "number"
    },
    "other_deductions": {
      "default": 0,
      "type": "number"
    },
    "overtime_gross": {
      "default": 0,
      "description": "Import brut de les hores extres (net / 0,935), cotitza a la CASS",
      "type": "number"
    },
    "overtime_hours": {
      "default": 0,
      "type": "number"
    },
    "overtime_net": {
      "default": 0,
      "description": "Import net de les hores extres (hores \u00d7 preu net)",
      "type": "number"
    },
    "overtime_pay": {
      "default": 0,
      "type": "number"
    },
    "period_month": {
      "type": "number"
    },
    "period_year": {
      "type": "number"
    },
    "precio_hora": {
      "default": 0,
      "description": "Preu per hora del treballador (\u20ac)",
      "type": "number"
    },
    "precio_hora_extra": {
      "default": 0,
      "description": "Preu per hora extra pactat, en net (\u20ac)",
      "type": "number"
    },
    "reclamacion_estado": {
      "enum": [
        "pendiente",
        "resuelta"
      ],
      "type": "string"
    },
    "reclamacion_fecha": {
      "format": "date-time",
      "type": "string"
    },
    "reclamacion_respuesta": {
      "type": "string"
    },
    "reclamacion_resuelta_fecha": {
      "format": "date-time",
      "type": "string"
    },
    "reclamacion_resuelta_por": {
      "type": "string"
    },
    "reclamacion_texto": {
      "description": "Reclamaci\u00f3 del treballador (art. 59.2, 7 dies)",
      "type": "string"
    },
    "status": {
      "default": "borrador",
      "enum": [
        "borrador",
        "emitida",
        "pagada"
      ],
      "type": "string"
    },
    "total_hours": {
      "default": 0,
      "description": "Hores treballades totals del per\u00edode",
      "type": "number"
    },
    "worker_signature_date": {
      "description": "Data de la firma digital del treballador",
      "format": "date-time",
      "type": "string"
    },
    "worker_signature_name": {
      "description": "Nom del treballador que ha firmat la n\u00f2mina",
      "type": "string"
    },
    "worker_signature_url": {
      "description": "URL de la imatge de la firma digital del treballador",
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "period_month",
    "period_year",
    "base_salary"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.employee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.employee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}